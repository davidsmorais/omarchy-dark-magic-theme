{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Omarchy",
  "author": "David Morais",
  "themes": [
    {
      "name": "Dark Magic",
      "appearance": "dark",
      "style": {
        "background": "#0f0f1790",
        "editor.background": "#0f0f1790",
        "editor.foreground": "#bbccee",
        "text": "#bbccee",
        "text.muted": "#bbccee70",
        "text.ignored": "#bbccee40",
        "text.placeholder": "#bbccee50",
        "ignored": "#bbccee30",
        "element.hover": "#66eeaa30",
        "ghost_element.hover": "#42426030",
        "ghost_element.selected": "#42426030",
        "ghost_element.active": "#42426060",
        "border": "#0f0f17",
        "editor.highlighted_line.background": "#42426010",
        "editor.active_line.background": "#42426010",
        "panel.background": "#07070f90",
        "title_bar.background": "#07070f90",
        "title_bar.inactive_background": "#07070f90",
        "status_bar.background": "#07070f90",
        "drop_target.background": "#07070f90",
        "elevated_surface.background": "#07070f",
        "toolbar.background": "#07070f90",
        "tab_bar.background": "#07070f90",
        "tab.inactive_background": "#07070f90",
        "tab.active_background": "#42426030",
        "scrollbar.track.background": "transparent",
        "scrollbar.track.border": "#0f0f17",
        "scrollbar.thumb.background": "#66eeaa",
        "editor.gutter.background": "#07070f90",
        "terminal.background": "#0f0f1710",
        "terminal.foreground": "#bbccee",
        "terminal.dim_foreground": "#bbccee",
        "terminal.bright_foreground": "#e8f0ff",
        "terminal.ansi.black": "#0f0f17",
        "terminal.ansi.red": "#bb324c",
        "terminal.ansi.green": "#b4f09e",
        "terminal.ansi.yellow": "#fbde66",
        "terminal.ansi.blue": "#6bc7f5",
        "terminal.ansi.magenta": "#cfa3f5",
        "terminal.ansi.cyan": "#66eeaa",
        "terminal.ansi.white": "#bbccee",
        "terminal.ansi.bright_black": "#424260",
        "terminal.ansi.bright_red": "#ff385e",
        "terminal.ansi.bright_green": "#00ffab",
        "terminal.ansi.bright_yellow": "#ffd31b",
        "terminal.ansi.bright_blue": "#38daff",
        "terminal.ansi.bright_magenta": "#db6797",
        "terminal.ansi.bright_cyan": "#52f3f3",
        "terminal.ansi.bright_white": "#e8f0ff",
        "modified": "#66eeaa",
        "syntax": {
          "attribute": {
            "color": "#66eeaa"
          },
          "boolean": {
            "color": "#ff9d62"
          },
          "comment": {
            "color": "#424260"
          },
          "comment.doc": {
            "color": "#424260"
          },
          "constant": {
            "color": "#ff9d62"
          },
          "function": {
            "color": "#6bc7f5"
          },
          "keyword": {
            "color": "#cfa3f5"
          },
          "number": {
            "color": "#ff9d62"
          },
          "operator": {
            "color": "#66eeaa"
          },
          "string": {
            "color": "#b4f09e"
          },
          "variable": {
            "color": "#bbccee"
          }
        },
        "players": [
          {
            "cursor": "#66eeaa",
            "background": "#0f0f17",
            "selection": "#66eeaa30"
          }
        ]
      }
    }
  ]
}
